# --- PRODUCTION ENVIRONMENT VARIABLES ---
# Change these values in your production hosting environment (Vercel/Render/etc.)

# Public site URL — used for ALL SEO (canonical tags, sitemap, OG, robots).
# MUST be the real customer-facing domain, NOT the vercel.app domain.
NEXT_PUBLIC_SITE_URL="https://gopimisthanbhandar.com"

# Auth callback URL — should match the domain users actually log in on.
# Set this to https://gopimisthanbhandar.com in Vercel once the custom domain is primary.
NEXTAUTH_URL="https://gopi-misthan-bhandar.vercel.app"
# Generate a DIFFERENT secret for production using: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_THIS_WITH_A_NEW_PROD_SECRET"

GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

MONGODB_URI="your-production-mongodb-uri"
